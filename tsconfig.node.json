{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/node",
    "types": ["node"]
  },
  "include": ["src/main", "src/media", "src/shared", "src/editor", "test", "vite.config.ts"],
  "exclude": ["test/media/generated", "test/output"]
}
